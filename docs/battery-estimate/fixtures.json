{
  "version": 1,
  "note": "Shared by web (src/lib/batteryEstimate.ts) and touch-ui (tests/estimate_test.c). Edit here, copy to touch-ui tests/fixtures/, update the sha256 in docs/battery-estimate.md.",
  "cases": [
    { "name": "charging steady to 100",
      "input": { "samples": [[0, 1000000, true], [60, 1000000, true], [120, 1000000, true], [180, 1000000, true]],
                 "soc": 50, "charge_full_uah": 11000000, "charge_counter_uah": null, "target_pct": 100, "paused_at_limit": false },
      "expect": { "kind": "charging_eta", "minutes": 330 } },
    { "name": "charging to limit 80",
      "input": { "samples": [[0, 1000000, true], [60, 1000000, true], [120, 1000000, true], [180, 1000000, true]],
                 "soc": 50, "charge_full_uah": 11000000, "charge_counter_uah": null, "target_pct": 80, "paused_at_limit": false },
      "expect": { "kind": "charging_eta", "minutes": 198 } },
    { "name": "discharging uses charge_counter",
      "input": { "samples": [[0, -500000, false], [60, -500000, false], [120, -500000, false]],
                 "soc": 93, "charge_full_uah": 11011000, "charge_counter_uah": 10280970, "target_pct": 100, "paused_at_limit": false },
      "expect": { "kind": "discharging_eta", "minutes": 1234 } },
    { "name": "discharging without charge_counter falls back to soc",
      "input": { "samples": [[0, -500000, false], [60, -500000, false]],
                 "soc": 50, "charge_full_uah": 11000000, "charge_counter_uah": null, "target_pct": 100, "paused_at_limit": false },
      "expect": { "kind": "discharging_eta", "minutes": 660 } },
    { "name": "current below 50 mA is unknown",
      "input": { "samples": [[0, 30000, true], [60, 30000, true]],
                 "soc": 50, "charge_full_uah": 11000000, "charge_counter_uah": null, "target_pct": 100, "paused_at_limit": false },
      "expect": { "kind": "unknown", "minutes": null } },
    { "name": "sign flip resets the window",
      "input": { "samples": [[0, -800000, true], [60, -800000, true], [120, 1000000, true], [180, 1000000, true]],
                 "soc": 50, "charge_full_uah": 11000000, "charge_counter_uah": null, "target_pct": 100, "paused_at_limit": false },
      "expect": { "kind": "charging_eta", "minutes": 330 } },
    { "name": "plug in resets the window",
      "input": { "samples": [[0, 2000000, false], [60, 2000000, false], [120, 2000000, true], [180, 2000000, true]],
                 "soc": 50, "charge_full_uah": 11000000, "charge_counter_uah": null, "target_pct": 100, "paused_at_limit": false },
      "expect": { "kind": "charging_eta", "minutes": 165 } },
    { "name": "samples older than 180 s are dropped",
      "input": { "samples": [[0, 3000000, true], [100, 1000000, true], [200, 1000000, true], [300, 1000000, true]],
                 "soc": 50, "charge_full_uah": 11000000, "charge_counter_uah": null, "target_pct": 100, "paused_at_limit": false },
      "expect": { "kind": "charging_eta", "minutes": 330 } },
    { "name": "average is time weighted",
      "input": { "samples": [[0, 2000000, true], [10, 1000000, true], [130, 1000000, true]],
                 "soc": 50, "charge_full_uah": 11000000, "charge_counter_uah": null, "target_pct": 100, "paused_at_limit": false },
      "expect": { "kind": "charging_eta", "minutes": 306 } },
    { "name": "single sample uses its own current",
      "input": { "samples": [[0, 1000000, true]],
                 "soc": 50, "charge_full_uah": 11000000, "charge_counter_uah": null, "target_pct": 100, "paused_at_limit": false },
      "expect": { "kind": "charging_eta", "minutes": 330 } },
    { "name": "paused at limit wins over current",
      "input": { "samples": [[0, -20000, true], [60, -20000, true]],
                 "soc": 80, "charge_full_uah": 11000000, "charge_counter_uah": null, "target_pct": 80, "paused_at_limit": true },
      "expect": { "kind": "paused_at_limit", "minutes": null } },
    { "name": "paused at limit even when usb reads offline",
      "input": { "samples": [[0, -350000, false], [60, -350000, false]],
                 "soc": 79, "charge_full_uah": 11000000, "charge_counter_uah": null, "target_pct": 80, "paused_at_limit": true },
      "expect": { "kind": "paused_at_limit", "minutes": null } },
    { "name": "full at 100 while trickle charging",
      "input": { "samples": [[0, 60000, true], [60, 60000, true]],
                 "soc": 100, "charge_full_uah": 11000000, "charge_counter_uah": null, "target_pct": 100, "paused_at_limit": false },
      "expect": { "kind": "reached_target", "minutes": null } },
    { "name": "full at 100 with a few mA drawn from the battery",
      "input": { "samples": [[0, -2929, true], [60, -2929, true]],
                 "soc": 100, "charge_full_uah": 11011000, "charge_counter_uah": 11011000, "target_pct": 100, "paused_at_limit": false },
      "expect": { "kind": "reached_target", "minutes": null } },
    { "name": "at target but clearly discharging while plugged is an eta",
      "input": { "samples": [[0, -500000, true], [60, -500000, true]],
                 "soc": 100, "charge_full_uah": 11000000, "charge_counter_uah": null, "target_pct": 100, "paused_at_limit": false },
      "expect": { "kind": "discharging_eta", "minutes": 1320 } },
    { "name": "above limit before policy pauses",
      "input": { "samples": [[0, 1000000, true], [60, 1000000, true]],
                 "soc": 81, "charge_full_uah": 11000000, "charge_counter_uah": null, "target_pct": 80, "paused_at_limit": false },
      "expect": { "kind": "reached_target", "minutes": null } },
    { "name": "charging without charge_full is unknown",
      "input": { "samples": [[0, 1000000, true], [60, 1000000, true]],
                 "soc": 50, "charge_full_uah": null, "charge_counter_uah": null, "target_pct": 100, "paused_at_limit": false },
      "expect": { "kind": "unknown", "minutes": null } },
    { "name": "no samples is unknown",
      "input": { "samples": [],
                 "soc": 50, "charge_full_uah": 11000000, "charge_counter_uah": null, "target_pct": 100, "paused_at_limit": false },
      "expect": { "kind": "unknown", "minutes": null } }
  ]
}
