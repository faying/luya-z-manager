# Copy this to scripts/.deploy.env (which is git-ignored) and fill in.
# Used by scripts/deploy.sh — never committed.

# SSH password for root@<device> on port 2222.
DEVICE_PASS='your-ssh-password'

# Optional: pin the device IP. If unset, deploy.sh probes
# 192.168.0.1, 192.168.1.1 and uses whichever answers SSH.
# DEVICE_HOST='192.168.0.1'

# Optional: override SSH port (default 2222).
# DEVICE_PORT='2222'
