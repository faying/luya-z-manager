# /data/chill/chill.env — CHILL 的本机设置（chill.sh 开头 source 它）。
# 复制成 chill.env 再改，chmod 600。里面是订阅地址，永远不要进任何仓库。
# 值里不能有单引号和换行（chill.sh 渲染时会拒绝）。

# 节点来源（template.yaml 的 proxy-providers）：
#   sub  type:http，订阅地址填这里（SUB_URL）
# 要加别的订阅或本地节点文件（type:file，放 /data/chill/providers/<名字>.yaml），就改 template.yaml 的 proxy-providers。
SUB_URL='https://…'

# 只保留这几个地区的节点（默认四个都要）：TW JP SG US
#CHILL_REGIONS='TW JP SG US'

# 这些局域网设备不走代理（按源 IP，设备要绑固定 IP）
#CHILL_BYPASS_IP='192.168.0.23 192.168.0.31'

# 国内直连用 nft 集合 + 一条 fwmark 规则做，不再把 CN 段写进 TUN 的 route-exclude-address
# （那样 table 2022 有 1.2 万条路由，mihomo 空载 CPU 大半花在反复读路由表）。语义不变；
# nft 没建成会自动退回旧做法。改了要重启 CHILL（/etc/init.d/chill restart）才生效。
#CHILL_CN_SET=1

# mihomo 控制口 :9999 默认只听本机。触屏和后台都在本机，后台的「CHILL 面板」按钮经 :9090/chill-ui/
# 反代，也不需要打开它。只有想让局域网设备直连 :9999 时才设 1，并用白名单限定来源：
#CHILL_API_LAN=1
#CHILL_API_ALLOW_IP='192.168.0.50'

# 给 :9999 加密钥。开之前先让触屏（chill.conf 的 secret=）知道，否则触屏先收到 401。
#CHILL_SECRET=''

# 过热 / 内存保护阈值（默认见 chill.sh 开头的 *_DEFAULT）
#CHILL_TEMP_HOT=
#CHILL_CORE_RSS_MAX=

# 家里出口：让一部分流量从家里的网络出去（国内版权、要家里 IP 的网站、其余都走家里）。
# 家里要有一台机器开着 SOCKS5（不要密码，只在家里局域网），设备经 Tailscale 子网路由能连到它。
# 不设 = 整个功能不出现。只认 IPv4:端口。
#CHILL_HOME_EXIT='192.0.2.10:1080'
# 下面三个开关由后台（触屏/网页）写，不用手改：
#CHILL_HOME_MEDIA=1     国内版权走家里
#CHILL_HOME_IP=1        家里 IP 网站走家里（域名一行一个，写在 /data/chill/home_ip.list）
#CHILL_HOME_REST=1      其余都走家里
# 家里出口的探测地址，要用国内能直接访问的 204（默认 http://connect.rom.miui.com/generate_204）
#CHILL_HOME_PROBE_URL=''
