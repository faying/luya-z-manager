#!/bin/sh /etc/rc.common
# procd service for luyaz-sentinel (manager crates/luyaz-sentinel; manager
# docs/designs/u60-sentinel.md): the screen owner and the
# must-still-happen watchdog duties. Installed by the install kit and
# `tools/luyaz ship scripts`; rc.local starts it with `/etc/init.d/luyaz-sentinel start`.
#
# Runs in power-off charging too: the UI shows its charging screen there. The
# sentinel itself keeps its worker idle in that mode (no Wi-Fi switched on in
# an "off" device).
#
# `stop` leaves the UI on screen; the next start adopts it. Hand the screen to
# the vendor UI with `echo vendor > /tmp/luyaz-screen.ctl`, not `stop`.
# Do NOT run `enable`/`disable` (overlay whiteouts, manager CLAUDE.md).
# SPDX-License-Identifier: MIT

START=97
USE_PROCD=1

BIN=/data/luyaz/luyaz-sentinel

start_service() {
    [ -x "$BIN" ] || return 1
    procd_open_instance
    # X9: stdout/stderr (a panic's last line) to their own RAM log, appended (the sentinel caps
    # it); not /tmp/luyaz-sentinel.log, which the sentinel writes line by line in its own shape.
    # exec: procd tracks the sentinel's pid, no sh left. One sentinel at a time is the program's
    # own lock (/tmp/luyaz/luyaz-sentinel.lock): a second copy exits 3.
    procd_set_param command /bin/sh -c 'exec >>/tmp/luyaz-sentinel.out 2>&1 </dev/null; echo "=== $(date +%Y-%m-%dT%H:%M:%S) start $0"; exec "$0" "$@"' "$BIN"
    procd_set_param respawn 300 5 5  # see luyaz-core.init for why 300
    procd_set_param term_timeout 10  # the UI gets TERM, 5 s, KILL only when stopping it; stop itself is quick
    procd_close_instance
}
